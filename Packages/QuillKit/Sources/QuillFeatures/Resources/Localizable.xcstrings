        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep Deleted Images"
          }
        }
      }
    },
    "Gelöschte Seiten bleiben hier 30 Tage und lassen sich wiederherstellen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
