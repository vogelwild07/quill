            "state" : "translated",
            "value" : "The backup no longer exists."
          }
        }
      }
    },
    "Das Backup stammt von einer neueren Quill-Version und kann hier nicht eingespielt werden." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The backup comes from a newer version of Quill and can’t be restored here."
          }
        }
      }
    },
    "Das Backup vor der Installation ist gescheitert. Quill hat nichts installiert." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The backup before installing failed. Quill didn’t install anything."
